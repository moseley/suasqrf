# Uber Direct — meal delivery.
# Self-serve credentials from https://direct.uber.com → Management → Developer.
# A sandbox account issues test credentials that never dispatch a real courier.
#
# Copy to .env.local for local work, and add the same keys in Vercel under
# Project → Settings → Environment Variables. None of these are NEXT_PUBLIC_:
# the client secret is server-only and must never reach the browser.
UBER_CUSTOMER_ID=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=

# Where couriers collect meals. Uber Direct is a courier network, not a
# restaurant — the pickup is your own kitchen or partner site.
UBER_PICKUP_NAME=
UBER_PICKUP_ADDRESS=
UBER_PICKUP_PHONE=

# Uber Guest Rides — rides for people without an Uber account.
# App credentials come from https://developer.uber.com → your app → Setup.
# The guests.trips scope is NOT self-serve: Uber support must grant it and
# whitelist you, or sandbox-api.uber.com answers 401.
UBER_RIDES_CLIENT_ID=
UBER_RIDES_CLIENT_SECRET=

# Sent as x-uber-organizationuuid. Required for third-party apps.
UBER_RIDES_ORG_ID=

# A sandbox run (POST /v1/guests/sandbox/run) creates mock drivers that live
# 8 hours. Paste its id here so trip requests attach to them, and refresh it
# when the run expires.
UBER_RIDES_SANDBOX_RUN_ID=

# "sandbox" (default) or "production". Guards which Uber hosts are called.
UBER_ENV=sandbox

# Local stand-in for Guest Rides while guests.trips approval is pending.
# Same shapes and status vocabulary as the real API; set to 1 to enable.
UBER_RIDES_MOCK=1

# Veterans To Veterans — the local ride service used when a rider asks for a
# veteran driver. Unset, the app falls back to a local stand-in.
VETERAN_RIDES_API_URL=
VETERAN_RIDES_API_KEY=
