# Uber Direct — meal delivery.
# Self-serve credentials from https://direct.uber.com → Management → Developer.
# A sandbox account issues test credentials that never dispatch a real courier.
#
# Copy to .env.local for local work, and add the same keys in Vercel under
# Project → Settings → Environment Variables. None of these are NEXT_PUBLIC_:
# the client secret is server-only and must never reach the browser.
UBER_CUSTOMER_ID=
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=

# Where couriers collect meals. Uber Direct is a courier network, not a
# restaurant — the pickup is your own kitchen or partner site.
UBER_PICKUP_NAME=
UBER_PICKUP_ADDRESS=
UBER_PICKUP_PHONE=

# Uber Guest Rides — rides for people without an Uber account.
# Requires an app at https://developer.uber.com with the guests.trips scope,
# plus whitelisting by Uber support before the sandbox will answer.
# Leave unset until that approval lands.
UBER_RIDES_CLIENT_ID=
UBER_RIDES_CLIENT_SECRET=

# "sandbox" (default) or "production". Guards which Uber hosts are called.
UBER_ENV=sandbox
